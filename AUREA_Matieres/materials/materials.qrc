<RCC>
  <qresource prefix="/materials">
    <file alias="theme.qss">theme.qss</file>
    <file alias="chevron_down.png">resources/chevron_down.png</file>
    <file alias="chevron_down@2x.png">resources/chevron_down@2x.png</file>
    <file alias="chevron_up.png">resources/chevron_up.png</file>
    <file alias="chevron_up@2x.png">resources/chevron_up@2x.png</file>
  </qresource>
  <qresource prefix="/assets">
    <file alias="logo_aurea.png">assets/logo_aurea.png</file>
    <file alias="fonts/Inter.ttf">assets/fonts/Inter.ttf</file>
    <file alias="fonts/CormorantGaramond.ttf">assets/fonts/CormorantGaramond.ttf</file>
    <file alias="fonts/CormorantGaramond-Italic.ttf">assets/fonts/CormorantGaramond-Italic.ttf</file>
  </qresource>
</RCC>
