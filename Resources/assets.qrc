    <file alias="assets/sounds/deconnexion.wav">Assets/sounds/deconnexion.wav</file>
    <file alias="assets/sounds/arrivee.wav">Assets/sounds/arrivee.wav</file>
    <file alias="assets/sounds/depart.wav">Assets/sounds/depart.wav</file>
    <file alias="assets/sounds/erreur.wav">Assets/sounds/erreur.wav</file>
    <file alias="assets/sounds/refus.wav">Assets/sounds/refus.wav</file>
    <file alias="assets/sounds/deja.wav">Assets/sounds/deja.wav</file>
    <file alias="assets/down.png">Assets/down.png</file>
    <file alias="assets/up.png">Assets/up.png</file>
    <file alias="assets/check.png">Assets/check.png</file>
    <file alias="assets/fonts/Inter.ttf">Assets/fonts/Inter.ttf</file>
    <file alias="assets/fonts/CormorantGaramond.ttf">Assets/fonts/CormorantGaramond.ttf</file>
