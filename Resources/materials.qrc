<RCC>
  <qresource prefix="/icons">
    <file alias="chevron_down.png">icons/chevron_down.png</file>
    <file alias="chevron_up.png">icons/chevron_up.png</file>
  </qresource>
  <qresource prefix="/materials">
    <file alias="theme.qss">theme.qss</file>
  </qresource>
  <qresource prefix="/">
    <file>assets/logo_aurea.png</file>
    <file>assets/fonts/Inter.ttf</file>
    <file>assets/fonts/CormorantGaramond.ttf</file>
    <file>assets/fonts/CormorantGaramond-Italic.ttf</file>
    <file>assets/sounds/valide.wav</file>
    <file>assets/sounds/alerte.wav</file>
    <file>assets/sounds/refus.wav</file>
  </qresource>
</RCC>
