/* AUREA — Gestion des matières. Même thème sombre / or que les modules Employés, Clients et Commandes.
   Polices : Inter (interface) et Cormorant Garamond (marque). */
QWidget { color: #f3f0ea; font-family: 'Inter', 'Segoe UI'; font-size: 10pt; }
QMainWindow, QWidget#centralwidget, QWidget#content, QWidget#body, QStackedWidget#pages,
QWidget#editorPageContents, QWidget#qrPageContents { background: #1b1b1d; }
QLabel { background: transparent; }

/* ---------- Menu latéral (remplacé par la rangée de boutons du haut dans l'Atelier) ---------- */
QFrame#sidebar { background: #151517; border: none; border-right: 1px solid #2a2a2d; }
QLabel#logoWord { font-family: 'Cormorant Garamond', 'Georgia'; font-size: 20pt; font-weight: 600; color: #e2cf9f; }
QLabel#brandSubtitle { color: #8f8c86; font-size: 7pt; font-weight: 500; }
QLabel#navCaption, QLabel#sidebarVersion { color: #77746d; font-size: 7.5pt; font-weight: 600; }
QLabel#sidebarNote { color: #8f8c86; font-size: 8.5pt; }
QPushButton[nav="true"] { text-align: left; background: transparent; border: none; border-radius: 9px; padding: 11px 14px; color: #c9c5bb; font-weight: 500; }
QPushButton[nav="true"]:hover { background: #222225; color: #fff7e0; }
QPushButton[nav="true"]:checked { color: #1c1c1e; font-weight: 600;
    background: qlineargradient(x1:0,y1:0,x2:1,y2:0, stop:0 #bfa370, stop:0.5 #e9d8a8, stop:1 #c4a876); }

/* ---------- Barre du haut ---------- */
QFrame#topbar { background: #1b1b1d; border: none; border-bottom: 1px solid #2a2a2d; }
QLabel[eyebrow="true"] { color: #c9b27c; font-size: 8pt; font-weight: 600; letter-spacing: 1px; }
QLabel#todayLabel { color: #b9b4a8; font-size: 9pt; background: #242427; border: 1px solid #323236; border-radius: 10px; padding: 8px 14px; }
QLabel#avatarUser { background: qlineargradient(x1:0,y1:0,x2:1,y2:1, stop:0 #4a4130, stop:1 #2e2a20); border: 1px solid #5a4f38; border-radius: 19px; color: #ecdcae; font-weight: 700; font-size: 9pt; }
QLabel#profileLabel { color: #f3f0ea; font-size: 9pt; }

/* ---------- Titres et textes ---------- */
QLabel[heading="true"] { font-size: 17pt; font-weight: 700; color: #ffffff; }
QLabel[muted="true"] { color: #8f8c86; font-size: 9pt; }
QLabel[section="true"] { font-size: 12pt; font-weight: 600; color: #f7f4ee; }
QLabel[value="true"] { font-size: 21pt; font-weight: 700; color: #ffffff; }
QLabel#valueValue { font-size: 18pt; }
QLabel[gold="true"] { color: #e2cf9f; }
QLabel#validationLabel { color: #d98b8b; }

/* ---------- Cartes ---------- */
QFrame[card="true"] { background: #232326; border: 1px solid #323236; border-radius: 12px; }
QFrame[card="true"] QLabel { background: transparent; border: none; }
QFrame[card="true"] QLabel[iconbox="true"] { background: #2e2e32; border: none; border-radius: 8px; }

/* ---------- Boutons ---------- */
QPushButton { background: #2a2a2d; color: #eeeae1; border: 1px solid #3a3a3f; border-radius: 9px; padding: 9px 16px; font-weight: 600; }
QPushButton:hover { background: #333337; border-color: #c9b27c; }
QPushButton:pressed { background: #3d3d42; }
QPushButton:disabled { color: #66645f; border-color: #2e2e32; background: #212124; }
QPushButton[primary="true"] { color: #1c1c1e; border: none;
    background: qlineargradient(x1:0,y1:0,x2:1,y2:0, stop:0 #c4a876, stop:0.5 #ebdcae, stop:1 #c9ad7a); }
QPushButton[primary="true"]:hover { background: qlineargradient(x1:0,y1:0,x2:1,y2:0, stop:0 #d0b684, stop:0.5 #f4e7bc, stop:1 #d4b988); }
QPushButton[primary="true"]:disabled { background: #2a2a2d; color: #66645f; border: 1px solid #2e2e32; }
QPushButton[danger="true"] { color: #f0b9bb; background: #3a2a2e; border-color: #5e3d44; }
QPushButton[danger="true"]:hover { background: #46313a; }
QPushButton[nav="true"]:disabled { background: transparent; }

/* ---------- Champs ---------- */
QLineEdit, QComboBox, QDoubleSpinBox, QSpinBox { background: #1d1d20; border: 1px solid #36363a; border-radius: 9px; padding: 8px 11px; color: #f3f0ea; min-height: 20px; selection-background-color: #d9c68f; selection-color: #1c1c1e; }
QLineEdit:focus, QComboBox:focus, QDoubleSpinBox:focus, QSpinBox:focus { border: 1px solid #c9b27c; }
QLineEdit:hover, QComboBox:hover, QDoubleSpinBox:hover, QSpinBox:hover { border-color: #4a4a50; }
QLineEdit:read-only { color: #b9b4a8; background: #232326; }
QLineEdit:disabled, QComboBox:disabled, QDoubleSpinBox:disabled { color: #66645f; background: #212124; }
QComboBox::drop-down { subcontrol-origin: padding; subcontrol-position: center right; border: none; width: 28px; }
QComboBox::down-arrow { image: url(:/clients/chevron_down.png); width: 12px; height: 12px; }
QDoubleSpinBox, QSpinBox { padding-right: 26px; }
QDoubleSpinBox::up-button, QSpinBox::up-button { subcontrol-origin: border; subcontrol-position: top right; width: 24px; border: none; border-top-right-radius: 9px; background: transparent; }
QDoubleSpinBox::down-button, QSpinBox::down-button { subcontrol-origin: border; subcontrol-position: bottom right; width: 24px; border: none; border-bottom-right-radius: 9px; background: transparent; }
QDoubleSpinBox::up-button:hover, QDoubleSpinBox::down-button:hover, QSpinBox::up-button:hover, QSpinBox::down-button:hover { background: #2e2e32; }
QDoubleSpinBox::up-arrow, QSpinBox::up-arrow { image: url(:/clients/chevron_up.png); width: 10px; height: 10px; }
QDoubleSpinBox::down-arrow, QSpinBox::down-arrow { image: url(:/clients/chevron_down.png); width: 10px; height: 10px; }
QComboBox QAbstractItemView { background: #242427; color: #f3f0ea; border: 1px solid #36363a; selection-background-color: #4a4434; selection-color: #fff6dc; outline: none; }
QCheckBox { spacing: 8px; }

/* ---------- Tableaux ---------- */
QTableWidget { background: #232326; alternate-background-color: #28282b; border: 1px solid #323236; border-radius: 12px; gridline-color: #303034; selection-background-color: #3c3727; selection-color: #fff6dc; outline: none; }
QFrame[card="true"] QTableWidget { background: transparent; alternate-background-color: transparent; border: none; border-radius: 0; }
QTableWidget::item { border-bottom: 1px solid #2f2f33; padding: 6px 8px; }
QTableWidget::item:hover { background: #2a2a2e; }
QTableWidget::item:selected { background: #3c3727; color: #fff6dc; }
QAbstractItemView:focus { outline: none; }
QHeaderView { background: transparent; }
QHeaderView::section { background: transparent; color: #8f8c86; border: none; border-bottom: 1px solid #323236; padding: 10px 8px; font-size: 9pt; font-weight: 500; text-align: left; }
QTableCornerButton::section { background: transparent; border: none; }
QScrollArea { background: transparent; border: none; }
QSplitter::handle { background: #323236; }

/* ---------- Défilement ---------- */
QScrollBar:vertical { background: transparent; width: 10px; margin: 2px; }
QScrollBar::handle:vertical { background: #4a4a50; border-radius: 3px; min-height: 28px; }
QScrollBar::handle:vertical:hover { background: #6a6a72; }
QScrollBar:horizontal { background: transparent; height: 10px; margin: 2px; }
QScrollBar::handle:horizontal { background: #4a4a50; border-radius: 3px; min-width: 28px; }
QScrollBar::add-line, QScrollBar::sub-line { width: 0; height: 0; }
QScrollBar::add-page, QScrollBar::sub-page { background: transparent; }

/* ---------- Divers ---------- */
QStatusBar { background: #151517; color: #8f8c86; font-size: 9pt; border-top: 1px solid #2a2a2d; }
QStatusBar::item { border: none; }
QDialog, QMessageBox { background: #1f1f22; }
QToolTip { background: #eee2bf; color: #23292b; border: none; padding: 7px; }
