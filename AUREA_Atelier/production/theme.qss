/* AUREA — module Production : même thème sombre / or que les autres modules.
   Les sélecteurs reprennent ceux du module Employés (palette, cartes, boutons, champs, tableaux). */
QWidget { color: #f3f0ea; font-family: 'Inter', 'Segoe UI'; font-size: 10pt; }
QMainWindow, QWidget#root { background: #1b1b1d; }
QLabel { background: transparent; border: none; }
QScrollArea, QScrollArea > QWidget > QWidget { background: transparent; border: none; }

/* ---------- Menu latéral (masqué dans l'Atelier : remplacé par la rangée du haut) ---------- */
QFrame#sidebar { background: #151517; border: none; border-right: 1px solid #2a2a2d; }
QLabel#brand { font-family: 'Cormorant Garamond', 'Georgia', serif; font-size: 20pt; font-weight: 600; color: #e2cf9f; }
QLabel#tagline { font-size: 7pt; font-weight: 500; color: #8f8c86; }
QPushButton[nav="true"] { text-align: left; background: transparent; border: none; border-radius: 9px; padding: 11px 14px; color: #c9c5bb; font-weight: 500; }
QPushButton[nav="true"]:hover { background: #222225; color: #fff7e0; }
QPushButton[nav="true"]:checked { color: #1c1c1e; font-weight: 600;
    background: qlineargradient(x1:0,y1:0,x2:1,y2:0, stop:0 #bfa370, stop:0.5 #e9d8a8, stop:1 #c4a876); }
QPushButton#help { text-align: left; background: transparent; border: none; color: #c9c5bb; padding: 10px 14px; font-weight: 500; }
QPushButton#help:hover { color: #fff7e0; }

/* ---------- Barre du haut ---------- */
QFrame#topbar { background: #1b1b1d; border: none; border-bottom: 1px solid #2a2a2d; }
QLabel#pageTitle { font-size: 17pt; font-weight: 700; color: #ffffff; }
QLabel#pageSub { color: #8f8c86; font-size: 9pt; }
QLabel#footer { color: #8f8c86; font-size: 9pt; }
QLineEdit#search { background: #242427; border: 1px solid #323236; border-radius: 10px; padding: 8px 12px 8px 6px; min-height: 20px; color: #f3f0ea; }
QLineEdit#search:focus { border: 1px solid #c9b27c; }

/* ---------- Cartes et textes ---------- */
QFrame[card="true"] { background: #232326; border: 1px solid #323236; border-radius: 12px; }
QFrame[mini="true"] { background: #2a2a2d; border: 1px solid #38383d; border-radius: 10px; }
QFrame[row="true"] { background: #2a2a2d; border: 1px solid #38383d; border-radius: 10px; }
QFrame#iconBox { background: #2e2e32; border: none; border-radius: 8px; }
QLabel[muted="true"] { color: #8f8c86; font-size: 9pt; }
QLabel[section="true"] { font-size: 12pt; font-weight: 600; color: #f7f4ee; }
QLabel[value="true"] { font-size: 21pt; font-weight: 700; color: #ffffff; }
QLabel[bigserif="true"] { font-family: 'Cormorant Garamond', 'Georgia', serif; font-size: 24pt; color: #e2cf9f; }
QLabel[ok="true"] { color: #7fc08a; font-weight: 600; }
QLabel[crit="true"] { color: #e0807a; font-weight: 600; }
QLabel#chip { color: #b9b4a8; font-size: 8pt; background: #2c2c30; border: 1px solid #3a3a3f; border-radius: 9px; padding: 4px 10px; }
QLabel#avatar { background: #3a3427; color: #e9d8a8; border-radius: 17px; font-weight: 700; }

/* ---------- Boutons ---------- */
QPushButton { background: #2a2a2d; color: #eeeae1; border: 1px solid #3a3a3f; border-radius: 9px; padding: 9px 16px; font-weight: 600; }
QPushButton:hover { background: #333337; border-color: #c9b27c; }
QPushButton:pressed { background: #3d3d42; }
QPushButton:disabled { color: #66645f; border-color: #2e2e32; background: #212124; }
QPushButton[primary="true"] { color: #1c1c1e; border: none;
    background: qlineargradient(x1:0,y1:0,x2:1,y2:0, stop:0 #c4a876, stop:0.5 #ebdcae, stop:1 #c9ad7a); }
QPushButton[primary="true"]:hover { background: qlineargradient(x1:0,y1:0,x2:1,y2:0, stop:0 #d0b684, stop:0.5 #f4e7bc, stop:1 #d4b988); }
QPushButton[danger="true"] { color: #f0b9bb; background: #3a2a2e; border: 1px solid #5e3d44; }
QPushButton[danger="true"]:hover { background: #46313a; border-color: #d98b8b; }
QPushButton#callout { text-align: left; color: #2a2417; font-size: 11pt; font-weight: 600; border: none; border-radius: 10px; padding: 16px 22px;
    background: qlineargradient(x1:0,y1:0,x2:1,y2:0, stop:0 #f1e6c8, stop:1 #e6d3a3); }
QPushButton#callout:hover { background: qlineargradient(x1:0,y1:0,x2:1,y2:0, stop:0 #f8eed2, stop:1 #ecdcb0); }
QPushButton#link { background: transparent; border: none; color: #e2cf9f; padding: 4px 0; text-align: left; }

/* ---------- Champs ---------- */
QLineEdit, QComboBox, QSpinBox, QDateEdit { background: #1d1d20; border: 1px solid #36363a; border-radius: 9px; padding: 8px 11px; min-height: 20px; color: #f3f0ea; selection-background-color: #d9c68f; selection-color: #1c1c1e; }
QLineEdit:focus, QComboBox:focus, QSpinBox:focus, QDateEdit:focus { border: 1px solid #c9b27c; }
QComboBox::drop-down, QDateEdit::drop-down { border: none; width: 24px; }
QComboBox QAbstractItemView { background: #242427; color: #f3f0ea; border: 1px solid #36363a; selection-background-color: #4a4434; outline: none; }

/* ---------- Tableaux et listes ---------- */
QTableView, QTableWidget { background: transparent; border: none; gridline-color: transparent; outline: 0; selection-background-color: rgba(201,178,124,36); selection-color: #fff6dc; }
QTableWidget::item { border-bottom: 1px solid #2f2f33; padding: 6px 8px; }
QHeaderView { background: transparent; border: none; }
QHeaderView::section { background: transparent; color: #8f8c86; border: none; border-bottom: 1px solid #323236; padding: 10px 8px; font-size: 9pt; font-weight: 500; }
QTableCornerButton::section { background: transparent; border: none; }
QListWidget { background: transparent; border: none; outline: 0; }
QListWidget::item { padding: 9px 8px; border-bottom: 1px solid #2f2f33; }
QListWidget::item:selected { background: rgba(201,178,124,36); color: #fff6dc; }

/* ---------- Progression ---------- */
QProgressBar { background: #3b3b40; border: none; border-radius: 2px; min-height: 4px; max-height: 4px; }
QProgressBar::chunk { border-radius: 2px; background: qlineargradient(x1:0,y1:0,x2:1,y2:0, stop:0 #bfa370, stop:1 #e9d8a8); }
QProgressBar[done="true"]::chunk { background: #7fc08a; }

/* ---------- Défilement ---------- */
QScrollBar:vertical { background: transparent; width: 10px; margin: 2px; }
QScrollBar::handle:vertical { background: #4a4a50; border-radius: 3px; min-height: 28px; }
QScrollBar::handle:vertical:hover { background: #6a6a72; }
QScrollBar:horizontal { background: transparent; height: 10px; margin: 2px; }
QScrollBar::handle:horizontal { background: #4a4a50; border-radius: 3px; min-width: 28px; }
QScrollBar::add-line, QScrollBar::sub-line { width: 0; height: 0; }
QScrollBar::add-page, QScrollBar::sub-page { background: transparent; }

/* ---------- Calendrier ---------- */
QCalendarWidget QWidget#qt_calendar_navigationbar { background: #232326; border-radius: 8px; }
QCalendarWidget QToolButton { color: #f3f0ea; background: transparent; border: none; padding: 6px 10px; font-weight: 600; }
QCalendarWidget QToolButton:hover { color: #e2cf9f; }
QCalendarWidget QAbstractItemView { background: #232326; color: #f3f0ea; selection-background-color: #c9b27c; selection-color: #1c1c1e; outline: 0; }
QCalendarWidget QAbstractItemView:disabled { color: #5a5750; }
QCalendarWidget QMenu { background: #242427; }

/* ---------- Divers ---------- */
QDialog, QMessageBox { background: #1f1f22; }
QToolTip { background: #eee2bf; color: #23292b; border: none; padding: 7px; }
