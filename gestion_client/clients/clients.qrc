<RCC>
    <qresource prefix="/clients">
        <file alias="logo.jpeg">resources/logo.jpeg</file>
        <file alias="logo.png">resources/logo_transparent.png</file>
        <file alias="style.qss">resources/style.qss</file>
        <file alias="chevron_down.png">resources/chevron_down.png</file>
        <file alias="chevron_down@2x.png">resources/chevron_down@2x.png</file>
        <file alias="chevron_up.png">resources/chevron_up.png</file>
        <file alias="chevron_up@2x.png">resources/chevron_up@2x.png</file>
    </qresource>
</RCC>
